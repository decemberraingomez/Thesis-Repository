MONGODB_URI=mongodb+srv://<db_username>:<db_password>@thesis-repo-db.zqvgspl.mongodb.net/thesis_repository?retryWrites=true&w=majority&appName=thesis-repo-db
PORT=3000

# One-time bootstrap administrator.
# These values are used only when the MongoDB AdminUser collection is empty.
# Set real values in your local .env; never commit working credentials.
# After bootstrap, MongoDB is the single source of truth; change the password at runtime
# through PUT /api/auth/password or recover it with: npm run admin:reset -- <email> <newPassword>
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-strong-bootstrap-password
ADMIN_NAME=Library Administrator

# Required. Signs HMAC-SHA256 session tokens; the API refuses to start without it.
# Use a strong random value (for example: openssl rand -hex 32).
# Rotating this value invalidates all sessions.
AUTH_SECRET=replace-with-a-strong-random-secret
